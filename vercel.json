{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": { "api/game.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/health", "destination": "/api/game?route=health" },
    { "source": "/api/:route(admin-login|admin-delete-room|admin-kick-user|login|state|create|join|quick|leave|edit|ready|ai|ai-edit|kick|rematch|logout|start|action|session|chat|emote)", "destination": "/api/game?route=:route" }
  ]
}
